DirectoryIndex index.html
Options -Indexes

RewriteEngine On

RewriteCond %{HTTP_HOST} ^tijcef\.org$ [NC]
RewriteRule ^ https://www.tijcef.org%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Dynamic content normally has a pre-rendered directory generated at build time.
# If a newly published item is requested before that snapshot exists, serve the
# React shell with HTTP 200 so the page can load from WordPress instead of being
# incorrectly reported as a 404. The next deploy creates its SEO snapshot.
RewriteRule ^post/[a-z0-9-]+/?$ /index.html [L,NC]
RewriteRule ^category/[a-z0-9-]+/?$ /index.html [L,NC]
RewriteRule ^grants/opportunities/[a-z0-9-]+/?$ /index.html [L,NC]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  <FilesMatch "^(404\.html)$">
    Header always set X-Robots-Tag "noindex, follow"
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
